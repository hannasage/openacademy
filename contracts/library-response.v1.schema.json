{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:touchline:contract:library-response.v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "focusRecordId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "local"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "cloud"
                  },
                  "hubId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "backendOrigin": {
                    "type": "string",
                    "pattern": "^https://(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:]+\\])(?::(?!443$)[1-9][0-9]{0,4})?$"
                  },
                  "accountId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "kind",
                  "hubId",
                  "backendOrigin",
                  "accountId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "curriculumId": {
            "$ref": "urn:touchline:contract:common.v1#/$defs/curriculumId"
          },
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "completed",
              "saved"
            ]
          },
          "revision": {
            "$ref": "urn:touchline:contract:common.v1#/$defs/revision"
          },
          "selectedModuleId": {
            "$ref": "urn:touchline:contract:common.v1#/$defs/moduleId"
          }
        },
        "additionalProperties": false,
        "required": [
          "recordId",
          "origin",
          "curriculumId",
          "title",
          "status",
          "revision",
          "selectedModuleId"
        ]
      }
    }
  },
  "required": [
    "version",
    "revision",
    "focusRecordId",
    "records"
  ],
  "additionalProperties": false
}
