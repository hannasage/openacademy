{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schola:contract:lesson-module:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "urn:schola:contract:lesson-common:v1#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:schola:contract:lesson-common:v1#/$defs/lessonId"
    },
    "version": {
      "$ref": "urn:schola:contract:lesson-common:v1#/$defs/contentVersion"
    },
    "title": {
      "$ref": "urn:schola:contract:lesson-common:v1#/$defs/title"
    },
    "outcome": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 1000
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "harness": {
      "$ref": "#/$defs/harness"
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:schola:contract:lesson-common:v1#/$defs/lessonId"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "price": {
      "$ref": "#/$defs/price"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "outcome",
    "blocks",
    "tasks",
    "checks",
    "prerequisites",
    "license"
  ],
  "additionalProperties": false,
  "$defs": {
    "body": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 50000
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "id": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
            },
            "body": {
              "$ref": "#/$defs/body"
            }
          },
          "required": [
            "type",
            "id",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "source-link"
            },
            "id": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
            },
            "title": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/title"
            },
            "url": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/httpUrl"
            },
            "note": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "type",
            "id",
            "title",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "interactive-code"
            },
            "id": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9+#.-]{0,29}$"
            },
            "starter": {
              "type": "string",
              "maxLength": 50000
            },
            "readOnly": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "id",
            "language",
            "starter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "check-reference"
            },
            "id": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
            },
            "checkId": {
              "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
            }
          },
          "required": [
            "type",
            "id",
            "checkId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "hint": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "urn:schola:contract:lesson-common:v1#/$defs/hintLevel"
        },
        "text": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "level",
        "text"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
        },
        "prompt": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 5000
        },
        "hints": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/hint"
          }
        }
      },
      "required": [
        "id",
        "prompt",
        "hints"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:schola:contract:lesson-common:v1#/$defs/localId"
        },
        "kind": {
          "enum": [
            "automated",
            "self-reported"
          ]
        },
        "description": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 2000
        },
        "runner": {
          "$ref": "#/$defs/runner"
        }
      },
      "required": [
        "id",
        "kind",
        "description"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "automated"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "runner": {
                "$ref": "#/$defs/runner"
              }
            },
            "required": [
              "runner"
            ]
          },
          "else": {
            "properties": {
              "runner": false
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "maxProperties": 20
    },
    "harness": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:schola:contract:lesson-common:v1#/$defs/lessonId"
        },
        "requiredPermissions": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "get_lesson",
              "get_attempt",
              "run_check",
              "request_hint",
              "log_reflection"
            ]
          }
        }
      },
      "required": [
        "id",
        "requiredPermissions"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "url": {
          "$ref": "urn:schola:contract:lesson-common:v1#/$defs/httpUrl"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    }
  }
}
