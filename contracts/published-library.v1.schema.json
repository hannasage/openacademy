{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:touchline:contract:published-library.v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "focusCurriculumId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "revision",
    "focusCurriculumId"
  ],
  "additionalProperties": false
}
