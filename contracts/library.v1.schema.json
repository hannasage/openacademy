{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:touchline:contract:library.v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "focusRecordId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "revision",
    "focusRecordId"
  ],
  "additionalProperties": false
}
