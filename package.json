{
  "name": "touchline-learning-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild web.jsx --bundle --format=esm --minify --outfile=web.bundle.js",
    "test": "python3 -m unittest -v test_server.py && python3 -m unittest discover -s tests -p \"test_*.py\" -v && node --test tests/*.test.mjs tests/browser/server.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:browser": "node tests/run-browser.mjs",
    "test:appearance": "node tests/run-appearance.mjs",
    "verify": "python3 scripts/check_permissions.py && npm run typecheck && npm run lint && npm test && npm run build",
    "test:backend": "python3 -m unittest discover -s backend/tests -p \"test_*.py\" -v"
  },
  "dependencies": {
    "@hannasage/projection-ui": "file:vendor/hannasage-projection-ui-0.2.0-next.2.tgz",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24",
    "npm": ">=10"
  }
}
