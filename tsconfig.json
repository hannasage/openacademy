{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "react",
      "react-dom"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "app.js",
    "web.jsx",
    "appearance.jsx",
    "sync.js",
    "types/**/*.d.ts",
    "web/**/*.js",
    "web/**/*.jsx",
    "hosted/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "web.bundle.js"
  ]
}
